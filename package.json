{
  "name": "cdp-web-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && tsup src/browser.ts --format iife --minify",
    "test": "vitest run",
    "ingest": "node ingest/server.ts",
    "dev": "npm run build && npm run ingest",
    "processor": "node --disable-warning=ExperimentalWarning processor/processor.ts",
    "seed": "node scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
